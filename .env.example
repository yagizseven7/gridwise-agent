# --- Model provider -----------------------------------------------------------
# auto (default): Azure OpenAI if endpoint + deployment are set, else Anthropic if
# ANTHROPIC_API_KEY is set, else the deterministic offline stand-ins.
GRIDWISE_PROVIDER=auto

# Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini              # your chat deployment name
# AZURE_OPENAI_API_KEY=...                          # or use Entra ID below
# AZURE_OPENAI_USE_ENTRA_ID=true                    # keyless: managed identity / az login (pip install azure-identity)
# AZURE_OPENAI_API_VERSION=                         # empty = v1 GA API; e.g. 2024-10-21 = classic deployment API
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small   # optional: neural embeddings for retrieval

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
GRIDWISE_MODEL=claude-sonnet-5-5

# "none" = the model's default temperature (required by Claude 5 and Azure reasoning models).
GRIDWISE_TEMPERATURE=none
GRIDWISE_MAX_RETRIES=2

# --- Agent ----------------------------------------------------------------------
GRIDWISE_MAX_STEPS=5
GRIDWISE_MAX_REPAIRS=1

# Forecast quality gate: answers above this hold-out MAPE are flagged for review.
GRIDWISE_MAPE_ALERT=0.12

# --- Guardrails -------------------------------------------------------------------
GRIDWISE_INJECTION_BLOCK=1.0     # injection score at which a question is refused / a passage quarantined
GRIDWISE_CLAIM_SUPPORT=0.6       # offline verifier: share of a claim's words that must be in one evidence unit
# GRIDWISE_RETRIEVAL_MIN=        # unset: 0.05 for local TF-IDF, 0.30 for Azure embeddings
GRIDWISE_LOG_PROMPTS=true        # log redacted prompts + completions in the trace

# Illustrative unit prices in EUR per 1M tokens. Set these to your contract rate.
GRIDWISE_PRICE_IN=3.0
GRIDWISE_PRICE_OUT=15.0
